{
  "name": "mariodevv/laravel-redsys-subscriptions",
  "description": "Suscripciones y cobros recurrentes con Redsys para Laravel. Tokenizacion COF/MIT y firma HMAC SHA-512.",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "redsys", "subscriptions", "recurring", "cashier", "payments", "spain", "bizum", "tpv"],
  "authors": [{ "name": "Mario Perez", "email": "perezmario.info@gmail.com", "homepage": "https://mariodevv.com" }],
  "require": {
    "php": "^8.2",
    "creagia/redsys-php": "^3.0",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": { "psr-4": { "MarioDevv\\RedsysSubscriptions\\": "src/" } },
  "autoload-dev": { "psr-4": { "MarioDevv\\RedsysSubscriptions\\Tests\\": "tests/" } },
  "extra": {
    "laravel": { "providers": ["MarioDevv\\RedsysSubscriptions\\RedsysSubscriptionsServiceProvider"] }
  },
  "scripts": { "test": "phpunit" },
  "minimum-stability": "stable",
  "config": { "sort-packages": true }
}
